{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoreWriter",
  "version": "0.2.1",
  "identifier": "com.lorewriter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoreWriter",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Atelier de storytelling",
    "longDescription": "Projets, personnages, relations, dialogues, roman, intrigues, recherche globale et synchronisation cloud — 100 % local, vos données restent chez vous.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
